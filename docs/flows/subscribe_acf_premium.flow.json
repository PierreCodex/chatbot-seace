{
  "version": "7.3",
  "routing_model": {
    "SUBSCRIBE": []
  },
  "screens": [
    {
      "id": "SUBSCRIBE",
      "title": "Crear alerta",
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextSubheading",
            "text": "¿Cómo quieres que te avise?"
          },
          {
            "type": "Dropdown",
            "name": "frequency",
            "label": "Frecuencia",
            "required": true,
            "data-source": [
              { "id": "daily", "title": "Diaria" },
              { "id": "weekly", "title": "Semanal" },
              { "id": "hourly", "title": "🔔 Prioritaria" }
            ]
          },
          {
            "type": "TextCaption",
            "text": "🔔 Prioritaria: te aviso en la próxima revisión (varias veces al día), no en el instante exacto de publicación."
          },
          {
            "type": "TextSubheading",
            "text": "¿Hasta cuándo mantengo la alerta?"
          },
          {
            "type": "CalendarPicker",
            "name": "end_date",
            "label": "Fecha de vencimiento",
            "mode": "single",
            "required": false
          },
          {
            "type": "OptIn",
            "name": "no_expiry",
            "label": "Sin vencimiento (alerta indefinida)"
          },
          {
            "type": "TextCaption",
            "text": "Elige una fecha o marca \"Sin vencimiento\". Si marcas ambos, vale \"Sin vencimiento\"."
          },
          {
            "type": "Footer",
            "label": "Crear alerta",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "frequency": "${form.frequency}",
                "end_date": "${form.end_date}",
                "no_expiry": "${form.no_expiry}"
              }
            }
          }
        ]
      }
    }
  ]
}
