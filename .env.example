# =====================================================================
# Chatbot SEACE — variables de entorno (sample). Copiar a .env y
# rellenar. NO commitear .env (ya está en .gitignore).
#
# Nota: usamos .env (no .env.local) porque Prisma CLI sólo carga .env
# nativamente. NestJS Config también lo lee. Una sola fuente de verdad.
# =====================================================================

# ---- Runtime --------------------------------------------------------
NODE_ENV=development
SERVICE=api                    # "api" o "worker"; cada terminal exporta el suyo
LOG_LEVEL=debug

API_PORT=3000
WORKER_PORT=3001

# ---- Postgres (Supabase dev) ----------------------------------------
# Pooler (pgbouncer) para conexiones runtime — F0/F1/F2+
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexión directa para prisma migrate (sin pgbouncer; usa advisory locks)
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Redis (Upstash) ------------------------------------------------
# rediss:// = TLS (Upstash exige TLS)
REDIS_URL="rediss://default:<password>@<host>.upstash.io:6379"

# ---- Canal de mensajería activo -------------------------------------
# "whatsapp" (Kapso) o "telegram". Ambos coexisten; el composition root bindea
# MESSAGING_PORT al adapter elegido. Ver docs/13-telegram-migracion.md.
MESSAGING_CHANNEL="whatsapp"

# ---- Kapso / WhatsApp (vacío en F0; obligatorio desde F3) -----------
KAPSO_API_KEY=""
KAPSO_WEBHOOK_SECRET=""

# ---- Telegram (grammY como Api-client) ------------------------------
# Token de @BotFather. El secret se valida contra el header
# X-Telegram-Bot-Api-Secret-Token al registrar el webhook (setWebhook).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# ---- Dueños del bot (sistema de roles/planes, ver docs/17) ----------
# Ids numéricos de Telegram separados por coma. Raíz de confianza: NUNCA en BD.
# Quien esté aquí puede usar todos los comandos admin. Ej: "111111111,222222222".
OWNER_IDS=""

# ---- URL pública del API (para servir el PDF de anuncios ACF) -------
# Dev = túnel ngrok (mismo que el webhook); prod = dominio Railway/Contabo.
# Si se deja vacío, el bot omite el PDF y muestra solo las 5 tarjetas.
PUBLIC_BASE_URL=""

# ---- Proxy para SEACE (opcional) ------------------------------------
# Si el IP del host está bloqueado por SEACE (datacenter, ej. Railway), poné un
# proxy residencial de PERÚ. Formato: http://usuario:password@host:puerto.
# Vacío = sin proxy (conexión directa, sirve en local con IP de Perú).
PROXY_URL=""

# ---- Crawler ACF agendado (motor de alertas F5, corre en el worker) -
# "true" activa el cron: incremental cada hora + completo 03:00. Dejar en
# "false" en dev/test/CI para no scrapear SEACE en cada arranque.
CRAWLER_ENABLED="false"

# ---- IA conversacional / NLU (docs/21) -------------------------------
# Proveedor detrás del LlmPort: "anthropic" (default) u "openai".
# Sin LLM_API_KEY el NLU queda inactivo (el bot funciona solo con botones).
LLM_PROVIDER="anthropic"
LLM_API_KEY=""
LLM_MODEL="claude-haiku-4-5"
# Kill-switch: "false" apaga el NLU sin deploy (fallback total a botones).
NLU_ENABLED="true"
# Presupuesto de la llamada NLU en ms; al agotarse → menú de botones.
NLU_TIMEOUT_MS="8000"
