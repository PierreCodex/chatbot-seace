{
  "name": "chatbot-seace",
  "version": "0.1.0",
  "private": true,
  "description": "Chatbot WhatsApp para consultar SEACE 3.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "dev": "concurrently -n api,worker -c blue,magenta \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:api": "cross-env SERVICE=api nest start --watch",
    "dev:worker": "cross-env SERVICE=worker nest start --watch --entryFile worker.main",
    "dev:logs:worker": "cross-env SERVICE=worker LOG_LEVEL=debug nest start --watch --entryFile worker.main",
    "start:api": "cross-env SERVICE=api node dist/main.js",
    "start:worker": "cross-env SERVICE=worker node dist/worker.main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed:dev": "node --env-file=.env --experimental-strip-types scripts/seed-dev.ts",
    "crawl:entities": "pnpm build && node --env-file=.env scripts/crawl-entities.mjs",
    "crawl:acf": "pnpm build && node --env-file=.env scripts/crawl-acf.mjs",
    "chat:sim": "pnpm build && node --env-file=.env scripts/chat-sim.mjs",
    "nlu:smoke": "pnpm build && node --env-file=.env scripts/nlu-smoke.mjs",
    "webhook": "node --env-file=.env scripts/webhook.mjs",
    "alerts:preview": "pnpm build && node --env-file=.env scripts/alerts-preview.mjs",
    "test": "vitest run",
    "test:repos": "cross-env TEST_REPOS=1 vitest run",
    "test:all": "vitest run && cross-env TEST_REPOS=1 vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^6.1.0",
    "bullmq": "^5.77.3",
    "date-fns": "^4.3.0",
    "grammy": "^1.43.0",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.2.0",
    "node-html-parser": "^7.1.0",
    "pdfkit": "^0.19.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.60.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^6.21.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
